# Copied to settings.local.toml by a deployment, with its own values. Any key left out keeps the value
# settings.toml gives it; BMO_DRIVE_<TABLE>__<KEY> in the environment overrides both.

[server]
listen = "127.0.0.1:3300"
token = "drive-token"

[store]
path = "/srv/bmo-drive/drive.db"

[node]
address = "http://127.0.0.1:3310"
token = "node-token"

[garage]
config = "/etc/garage.toml"
profile = "garage"

[share]
address = "https://files.example.com/files/share"
actor = "drive-command"

[owners]
administrator = "1"

[console]
token = "drive-console-token"

[storage]
kind = "local"
root = "/srv/bmo-data/drive/spaces"
backup = "The data root's hourly snapshot, kept on this machine and copied off it."

[quota]
default_bytes = 5368709120

[protect.posix]
home_named = [{ under = "repos/example", starting = "bmo" }]

[protect.local]
extra = ["/srv/bmo-data", "/srv/bmo-drive"]
